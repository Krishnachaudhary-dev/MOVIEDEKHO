# ── MovieDekho environment variables ─────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.
# Get a free TMDB key at https://www.themoviedb.org/settings/api
#
# Nothing here is a real credential. `.env.local` is gitignored.

# ── TMDB credentials ────────────────────────────────────────────────────────
# v3 API Key (the 32-char "API Key" string on the TMDB settings page).
# Used server-side only — preferred over the NEXT_PUBLIC_ variant below.
TMDB_API_KEY=

# v4 API Read Access Token (the long JWT-looking string). If set, it takes
# precedence over TMDB_API_KEY and is sent as `Authorization: Bearer …`.
# Optional — most people only need the v3 key.
TMDB_ACCESS_TOKEN=

# Browser-visible key. Required for the debounced client-side search bar,
# because that request is issued from the browser. If you leave it empty the
# app still works, but search must go through a server route instead.
NEXT_PUBLIC_TMDB_API_KEY=

# ── Optional overrides ──────────────────────────────────────────────────────
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# TMDB_LANGUAGE=en-US
# Seconds TMDB responses stay in the Next.js data cache. Default: 300.
# TMDB_REVALIDATE_SECONDS=300
